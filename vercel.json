{
  "version": 2,
  "name": "meu-backlog",
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "js/*.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/index-phase2.html"
    },
    {
      "src": "^/login/?$",
      "dest": "/index-phase2.html"
    },
    {
      "src": "^/index\\.html$",
      "dest": "/index-phase2.html"
    },
    {
      "src": "^/app/?$",
      "dest": "/app-phase2.html"
    },
    {
      "src": "^/app\\.html$",
      "dest": "/app-phase2.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
