{
  "version": 2,
  "name": "meu-backlog",
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "js/*.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/index-phase4.html"
    },
    {
      "src": "^/login/?$",
      "dest": "/index-phase4.html"
    },
    {
      "src": "^/index\\.html$",
      "dest": "/index-phase4.html"
    },
    {
      "src": "^/app/?$",
      "dest": "/app-phase4.html"
    },
    {
      "src": "^/app\\.html$",
      "dest": "/app-phase4.html"
    },
    {
      "src": "^/fase4/?$",
      "dest": "/index-phase4.html"
    },
    {
      "src": "^/login-fase4/?$",
      "dest": "/index-phase4.html"
    },
    {
      "src": "^/app-fase4/?$",
      "dest": "/app-phase4.html"
    },
    {
      "src": "^/app-fase4\\.html$",
      "dest": "/app-phase4.html"
    },
    {
      "src": "^/phase4/?$",
      "dest": "/index-phase4.html"
    },
    {
      "src": "^/phase4/login/?$",
      "dest": "/index-phase4.html"
    },
    {
      "src": "^/phase4/app/?$",
      "dest": "/app-phase4.html"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1.js"
    },
    {
      "src": "^/(.*)$",
      "dest": "/$1"
    }
  ]
}
